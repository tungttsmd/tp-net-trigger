# ====== APP API SETTING ======

HOST_VERSION=1.0
HOST_FROM_PREFIX=tp-net-trigger

# DEVICE_TYPE IS UNIQUE ON TRIGGER (PLEASE NOTE IT)
HOST_DEVICE_TYPE=node-server-x

# ====== MQTT SERVICE ======

MQTT_SERVER_HOST=127.0.0.1
MQTT_SERVER_PORT=1881

MQTT_OPT_USERNAME=
MQTT_OPT_PASSWORD=

MQTT_INIT_MAX_FAIL_TO_REBOOT=10

# PUB CHANNEL (CommandHandler/Modules) Need host id + device type
MQTT_RUNTIME_TOPIC=winwtsvc/:hostId-:hostDeviceType/runtime
MQTT_PROFILE_TOPIC=winwtsvc/:hostId-:hostDeviceType/profile
MQTT_HEALTH_TOPIC=winwtsvc/:hostId-:hostDeviceType/health
MQTT_SENSOR_TOPIC=winwtsvc/:hostId-:hostDeviceType/sensor
MQTT_SYSTEM_TOPIC=winwtsvc/:hostId-:hostDeviceType/system
MQTT_SIGNAL_TOPIC=winwtsvc/:hostId-:hostDeviceType/signal

# SUB CHANNEL (Services/Facade/MqttService.java) Need full identify (prefix + host id + hwid)
MQTT_CONTROL_TOPIC=winttsvc/:hostFromPrefix-:hostId-:hostHwid/control

# SIGNAL KEY ON MESSAGE MQTT
MQTT_SIGNAL_TARGET_KEY=trigger:facade::hostId

# ====== POOL WORKER ======

POOL_WORKER_PREFIX=worker
POOL_WORKER_PREFIX_THREAD_NAME=thread

POOL_WORKER_COUNT=16

# ====== SENSOR WEBSERVER ======

SENSOR_WEBSERVER_HOST=http://127.0.0.1:1883
SENSOR_WEBSERVER_RAW_PATH=/raw
SENSOR_MAX_FAIL_TO_REBOOT=10

# ====== HEALTH NETWORK ======

HEALTH_NETWORK_PING_COUNT=6
HEALTH_NETWORK_TARGETS=8.8.8.8

# ====== WALLPAPER ======

WALLPAPER_URL=https://drive.usercontent.google.com/uc?id=1fxxVcxFjLRKAFqd1q6Wp9NeIeStszopW&export=download

