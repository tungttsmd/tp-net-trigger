# ====== APP API SETTING ======

HOST_VERSION=1.0
HOST_FROM_PREFIX=tp-net-trigger

# DEVICE_TYPE IS UNIQUE ON TRIGGER (PLEASE NOTE IT)
HOST_DEVICE_TYPE=node-server-x

# ====== MQTT SERVICE ======

MQTT_SERVER_HOST=127.0.0.1
MQTT_SERVER_PORT=1881

MQTT_OPT_USERNAME=
MQTT_OPT_PASSWORD=

# PUB CHANNEL (CommandHandler/Modules) Need prefix + host id
MQTT_RUNTIME_TOPIC=winsv_wtpsvn/:hostFromPrefix-:hostId-:hostDeviceType/runtime
MQTT_PROFILE_TOPIC=winsv_wtpsvn/:hostFromPrefix-:hostId-:hostDeviceType/profile
MQTT_HEALTH_TOPIC=winsv_wtpsvn/:hostFromPrefix-:hostId-:hostDeviceType/health
MQTT_SENSOR_TOPIC=winsv_wtpsvn/:hostFromPrefix-:hostId-:hostDeviceType/sensor
MQTT_SYSTEM_TOPIC=winsv_wtpsvn/:hostFromPrefix-:hostId-:hostDeviceType/system
MQTT_SIGNAL_TOPIC=winsv_ftpsvn/:hostFromPrefix-:hostId-:hostDeviceType/signal

# SUB CHANNEL (Services/Facade/MqttService.java) Need full identify (prefix + host id + hwid)
MQTT_CONTROL_TOPIC=winsv_ttpsvn/:hostFromPrefix-:hostId-:hostHwid/control

# SIGNAL KEY ON MESSAGE MQTT
MQTT_SIGNAL_TARGET_KEY=trigger:facade::hostId

# ====== POOL WORKER ======

POOL_WORKER_PREFIX=worker
POOL_WORKER_PREFIX_THREAD_NAME=thread

POOL_WORKER_COUNT=16

# ====== SENSOR WEBSERVER ======

SENSOR_WEBSERVER_HOST=http://127.0.0.1:1883
SENSOR_WEBSERVER_RAW_PATH=/raw

# ====== HEALTH NETWORK ======

HEALTH_NETWORK_PING_COUNT=6
HEALTH_NETWORK_TARGETS=8.8.8.8
