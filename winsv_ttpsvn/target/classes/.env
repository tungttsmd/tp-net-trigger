AGENT_VERSION=1.0

# ====== APP API SETTING ======

HOST_VERSION=1.0
HOST_FROM_PREFIX=java-node-trigger

UPDATE_FOLDER=update
UPDATE_RUN_FILE=update.exe

# ====== MQTT SERVICE ======

MQTT_SERVER_HOST=127.0.0.1
MQTT_SERVER_PORT=1881

MQTT_OPT_CLEAN_SESSION=true
MQTT_OPT_CONNECTION_TIMEOUT=30
MQTT_OPT_KEEP_ALIVE=60
MQTT_OPT_FALLBACK_QOS=0

MQTT_RUNTIME_TOPIC=winsv_wtpsvn/:hostId/runtime
MQTT_PROFILE_TOPIC=winsv_wtpsvn/:hostId/profile
MQTT_HEALTH_TOPIC=winsv_wtpsvn/:hostId/health
MQTT_SENSOR_TOPIC=winsv_wtpsvn/:hostId/sensor
MQTT_SYSTEM_TOPIC=winsv_wtpsvn/:hostId/system
MQTT_SIGNAL_TOPIC=winsv_ftpsvn/:hostId/signal

MQTT_CONTROL_TOPIC=winsv_atpsvn/:hostId/control

MQTT_SIGNAL_TARGET_KEY=agent:facade::hostId

# ====== POOL WORKER ======

POOL_WORKER_PREFIX=worker
POOL_NAMED_THREAD_PREFIX=thread

POOL_WORKER_COUNT=16

POOL_THREAD_HEARTBEAT_EXPIRE=10
POOL_THREAD_HEARTBEAT_INTERVAL=5000

# ====== SENSOR WEBSERVER ======

SENSOR_WEBSERVER_HOST=http://127.0.0.1:1883
SENSOR_WEBSERVER_RAW_PATH=/raw
